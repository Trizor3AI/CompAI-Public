<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.53.23.0</Version>
    <IconUrl>https://github.com/Trizor3AI/CompAI-Public/releases/download/v$(Version)/icon.png</IconUrl>
    <Name>CompAI</Name>
    <Tags>CompAI</Tags>
    <Author>Trizor3</Author>
    <Authors>Trizor3</Authors>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <Copyright>Copyright (c) 2026 Trizor3</Copyright>
    <Punchline>Your AI sidekick for adventures, answers, and a little banter.</Punchline>
    <Description>An AI companion for quest questions, gear ideas, crafting plans, or a chat between adventures. Pick its personality and choose which game details it can see. Open /compai to chat, or /compai settings to get started. Requires a supported AI account.</Description>
    <AcceptsFeedback>false</AcceptsFeedback>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- Keep file and line information useful without recording the checkout or its Git origin. -->
    <DebugType>embedded</DebugType>
    <EnableSourceLink>false</EnableSourceLink>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <GenerateRepositoryUrlAttribute>false</GenerateRepositoryUrlAttribute>
    <EmbedUntrackedSources>false</EmbedUntrackedSources>
    <EmbedAllSources>false</EmbedAllSources>
    <!-- Use the same virtual root on a local build and on CI. -->
    <DeterministicSourcePaths>false</DeterministicSourcePaths>
    <PathMap>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..').Replace(',', ',,').Replace('=', '=='))=/_/CompAI/</PathMap>
  </PropertyGroup>
